# Runtime serverless: Supavisor Transaction Pooler (puerto 6543). El usuario
# incluye el project ref; pgbouncer=true evita prepared statements y
# connection_limit=1 limita cada instancia PrismaPg en Vercel.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma CLI: Supavisor Session Pooler (puerto 5432) para migraciones. Copiar
# el host/región exactos desde Supabase Connect; no usar db.[PROJECT-REF].
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth y Storage. Usar la Publishable Key actual del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR_KEY]"

# Exclusiva de lib/supabase/storage-admin.ts para Storage administrativo.
# Nunca exponerla al navegador ni usarla para Auth o autorización.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[YOUR_SERVICE_ROLE_KEY]"

# Secreto independiente para HMAC de IP/email y cookie administrativa. Generar
# uno aleatorio de al menos 32 caracteres; no reutilizar ninguna otra clave.
SECURITY_HMAC_SECRET="[GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS]"

# Turnstile: la Site Key se entrega desde el Server Component al formulario; la
# Secret Key solo se usa al verificar el token en el Route Handler.
TURNSTILE_SITE_KEY="[YOUR_TURNSTILE_SITE_KEY]"
TURNSTILE_SECRET_KEY="[YOUR_TURNSTILE_SECRET_KEY]"
TURNSTILE_EXPECTED_HOSTNAME="localhost"

# Vercel Cron lo envía automáticamente como Authorization: Bearer <valor>.
# Es privado y debe tener al menos 16 caracteres aleatorios.
CRON_SECRET="[GENERATE_A_RANDOM_CRON_SECRET_AT_LEAST_16_CHARACTERS]"

# Sentry: el DSN de navegador es un identificador de ingesta público, no una
# credencial administrativa. No agregar SENTRY_AUTH_TOKEN al runtime.
SENTRY_DSN="[YOUR_SENTRY_SERVER_DSN]"
NEXT_PUBLIC_SENTRY_DSN="[YOUR_SENTRY_BROWSER_DSN]"

# Checkout Pro se mantiene bloqueado en TEST. El Access Token y la firma de
# Webhooks son exclusivos del servidor. APP_BASE_URL debe ser la URL HTTPS
# pública exacta del deployment, sin slash final, query ni hash.
MERCADO_PAGO_MODE="TEST"
MERCADO_PAGO_ACCESS_TOKEN="TEST-[YOUR_TEST_ACCESS_TOKEN]"
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="[YOUR_TEST_PUBLIC_KEY_NOT_USED_BY_REDIRECT_FLOW]"
MERCADO_PAGO_WEBHOOK_SECRET="[YOUR_TEST_WEBHOOK_SECRET]"
APP_BASE_URL="https://[YOUR-PREVIEW-DOMAIN]"
